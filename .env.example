# ---------------------------------------------------------------------------
# STAYR — site configuration. Copy to .env.local. Everything NEXT_PUBLIC_*
# ships to the browser; nothing here is a secret. Never put a private key in
# this file — the deployer key lives in contracts/.env (see contracts/.env.example).
# ---------------------------------------------------------------------------

# Which chain this build talks to: 4663 Robinhood Chain, 46630 testnet, 31337 local node.
NEXT_PUBLIC_CHAIN_ID=4663

# Deployed contracts. Leave EMPTY until you have deployed: the site then shows
# its "not deployed" status everywhere instead of an address. With
# NEXT_PUBLIC_CHAIN_ID=31337 these are read from contracts/deployments/local.json
# automatically after `npm run deploy:local`.
NEXT_PUBLIC_STAYR_TOKEN=
NEXT_PUBLIC_STAYR_REWARDS=

# Set to true only once Blockscout shows the verified source for both contracts.
NEXT_PUBLIC_SOURCE_VERIFIED=false

# Public source repository; the "repository" links appear only when set.
NEXT_PUBLIC_REPO_URL=

# The only host the app should be served from. Any other host is flagged in
# the app's trust bar (local builds excepted).
NEXT_PUBLIC_OFFICIAL_HOST=stayr.xyz

# Block the vault was deployed at: the claim-history scan starts there
# (otherwise the last 4M blocks, in 400k chunks).
NEXT_PUBLIC_STAYR_START_BLOCK=

# Optional: where "Trade STAYR" links go (e.g. the Uniswap swap URL for the token).
NEXT_PUBLIC_TRADE_URL=

# Public site URL for metadata.
NEXT_PUBLIC_SITE_URL=https://stayr.xyz

# RPC overrides (defaults are the official public endpoints).
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_TESTNET_RPC_URL=
NEXT_PUBLIC_LOCAL_RPC_URL=

# Server-only: the relay at /api/rpc uses RPC_URL first, then the chain's
# default, then RPC_FALLBACKS (comma-separated), skipping 429/5xx.
RPC_URL=
RPC_FALLBACKS=

# Local venue addresses (chain 31337 only; filled from local.json automatically).
NEXT_PUBLIC_UNISWAP_V2_FACTORY=
NEXT_PUBLIC_UNISWAP_V2_ROUTER=
NEXT_PUBLIC_WETH=
NEXT_PUBLIC_USDG=
