# Contracts — copy to contracts/.env. Never commit the real file.

# Deployer key for testnet / mainnet. Leave empty for local work.
DEPLOYER_PRIVATE_KEY=

# RPC overrides (defaults: official public endpoints).
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Venue addresses for deploy.ts — must be verified for the target chain.
# Robinhood Chain MAINNET values (verified on chain 2026-09-28):
#   UNISWAP_V2_FACTORY=0x8bceaa40b9acdfaedf85adf4ff01f5ad6517937f
#   UNISWAP_V2_ROUTER=0x89e5db8b5aa49aa85ac63f691524311aeb649eba
#   WETH=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
#   USDG=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
# Testnet: not published in the official docs — fill from a verified source.
UNISWAP_V2_FACTORY=
UNISWAP_V2_ROUTER=
WETH=
USDG=

# Who receives the initial supply (defaults to the deployer).
SUPPLY_RECIPIENT=

# Economics overrides (defaults = the local assumptions in ECONOMICS.md).
STAYR_FEE_BPS=200
STAYR_EPOCH_SECONDS=60
STAYR_BASE_MULTIPLIER_BPS=10000
STAYR_HARVEST_CAP_BPS=50
STAYR_HARVEST_COOLDOWN=600
STAYR_FORFEIT_ON_SALE=false

# Mainnet safety latch for deploy.ts.
CONFIRM_MAINNET=

# Blockscout needs no key; kept for parity.
ROBINHOOD_EXPLORER_API_KEY=
